# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and never committed.

# --- Contact form (src/app/api/contact/route.ts) ---
# Required to actually send email. Without it, the form returns a clear
# error asking the visitor to use the email/LinkedIn links instead.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in the Resend account.
# Falls back to Resend's shared sandbox sender (testing only) if unset.
CONTACT_FROM_EMAIL="Sajid Ali Portfolio <onboarding@resend.dev>"

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=sajid_ch1@yahoo.com

# --- LinkedIn URL (src/data/profile.ts) ---
# OPEN QUESTION: multiple slug variants exist across source materials.
# Confirm the correct one with Sajid before launch.
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/sajid-ali-0740aa28
